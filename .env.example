# UJMAH V2 — Environment Variables Template
# Copy this file to '.env' and fill in the real values.
# NEVER push the '.env' file containing real secrets to GitHub!

# Application URL configurations
PORT=5000
FRONTEND_URL="http://localhost:5173"
APP_URL="http://localhost:5000"

# Authentication secret (make it long and randomly generated)
JWT_SECRET="generate_a_very_strong_random_secret_string"

# Database Configuration (Neon PostgreSQL)
# DATABASE_URL: connection string with pooling (transaction connection)
DATABASE_URL="postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require&pgbouncer=true"

# DIRECT_URL: connection string bypassing pgbouncer (direct connection for migrations)
DIRECT_URL="postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require"
